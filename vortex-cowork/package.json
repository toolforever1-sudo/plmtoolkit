{
  "name": "vortex-cowork",
  "version": "1.0.0",
  "description": "Claude Cowork-style desktop app using Vortex API Gateway",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder",
    "package:mac": "electron-vite build && electron-builder --mac",
    "postinstall": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "com.sandisk.vortex-cowork",
    "productName": "Vortex Cowork",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.363.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.2.0",
    "marked": "^12.0.0",
    "node-ssh": "^13.2.1",
    "openai": "^4.29.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "simple-git": "^3.36.0",
    "xlsx": "^0.18.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranav-sankaran-671998-sndk/vortex-cowork.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pranav-sankaran-671998-sndk/vortex-cowork/issues"
  },
  "homepage": "https://github.com/pranav-sankaran-671998-sndk/vortex-cowork#readme"
}
